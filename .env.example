NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: Supabase project settings > API > service_role key.
# Used by admin moderation actions to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin. Sign up one of these
# emails as a regular therapist account, then it gets admin access on login.
ADMIN_EMAILS=
